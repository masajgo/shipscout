<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.shipscout.ownerscan</string>

  <!-- launchd StandardOutPath causes EDEADLK (-11) in Node 24 + macOS 15 because
       launchd opens the log file with exclusive locking before Node starts.
       Fix: let bash handle redirection instead — node inherits normal pipe FDs. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>mkdir -p "$HOME/Library/Logs/shipscout"; for i in 1 2 3 4 5; do /usr/bin/caffeinate -i /usr/local/bin/node /Users/macbook/Desktop/shipscout/scraper/dailyOwnerScan.js >> "$HOME/Library/Logs/shipscout/daily_scan.log" 2>> "$HOME/Library/Logs/shipscout/daily_scan.err.log" &amp;&amp; break || sleep 15; done</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/macbook/Desktop/shipscout</string>

  <!-- Every day at 09:00 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/macbook</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
